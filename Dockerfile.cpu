FROM docker.m.daocloud.io/library/python:3.12-slim
WORKDIR /app
COPY requirements-app.txt /app/requirements-app.txt
RUN pip install --no-cache-dir -r requirements-app.txt && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.7.1 && \
    pip install --no-cache-dir transformers==4.53.2
COPY pyproject.toml README.md /app/
COPY src /app/src
COPY app /app/app
COPY scripts /app/scripts
COPY reports /app/reports
COPY data/demo /app/data/demo
ENV PYTHONPATH=/app/src:/app/scripts
EXPOSE 8000 8501
CMD ["uvicorn", "scripts.run_r16_api:app", "--host", "0.0.0.0", "--port", "8000"]
